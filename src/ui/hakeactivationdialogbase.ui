                  <property name="styleSheet"><string notr="true">font-weight: 600; font-size: 11.5px; color: #1e293b;</string></property>
                  <property name="text"><string>Licensed Email Address</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QLineEdit" name="txtPayEmail">
                  <property name="styleSheet"><string notr="true">background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 7px; font-size: 12.5px; padding: 7px 10px;</string></property>
                  <property name="text"><string>alex@geospatial.com</string></property>
                 </widget>
                </item>

                <item>
                  <widget class="QLabel" name="lblPayCardLabel">
                   <property name="styleSheet"><string notr="true">font-weight: 600; font-size: 11.5px; color: #1e293b;</string></property>
                   <property name="text"><string>16-Digit Card Number</string></property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QLineEdit" name="txtPayCardNumber">
                   <property name="maxLength">
                    <number>19</number>
                   </property>
                   <property name="placeholderText">
                    <string>1234 5678 9012 3456</string>
                   </property>
                   <property name="styleSheet"><string notr="true">background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 7px; font-size: 13.5px; font-family: monospace; letter-spacing: 1.2px; padding: 7px 10px;</string></property>
                   <property name="text"><string/></property>
                  </widget>
                 </item>

                 <item>
                  <layout class="QHBoxLayout" name="payExpCvcRow">
                   <item>
                    <layout class="QVBoxLayout" name="payExpCol">
                     <item>
                      <widget class="QLabel" name="lblPayExp"><property name="styleSheet"><string notr="true">font-weight: 600; font-size: 11.5px; color: #1e293b;</string></property><property name="text"><string>Expiry Date</string></property></widget>
                     </item>
                     <item>
                      <widget class="QLineEdit" name="txtPayExpiry">
                       <property name="maxLength">
                        <number>5</number>
                       </property>
                       <property name="placeholderText">
                        <string>MM/YY</string>
                       </property>
                       <property name="styleSheet"><string notr="true">background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 7px; font-size: 12.5px; padding: 7px 10px;</string></property>
                       <property name="text"><string/></property>
                      </widget>
                     </item>
                    </layout>
                   </item>
                   <item>
                    <layout class="QVBoxLayout" name="payCvcCol">
                     <item>
                      <widget class="QLabel" name="lblPayCvc"><property name="styleSheet"><string notr="true">font-weight: 600; font-size: 11.5px; color: #1e293b;</string></property><property name="text"><string>CVC</string></property></widget>
                     </item>
                     <item>
                      <widget class="QLineEdit" name="txtPayCvc">
                       <property name="maxLength">
                        <number>4</number>
                       </property>
                       <property name="placeholderText">
                        <string>CVC</string>
                       </property>
                       <property name="styleSheet"><string notr="true">background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 7px; font-size: 12.5px; padding: 7px 10px;</string></property>
                       <property name="text"><string/></property>
                      </widget>
                     </item>
                    </layout>
                   </item>
                  </layout>
                 </item>

                 <item>
                  <widget class="QLabel" name="lblPayError">
                   <property name="visible">
                    <bool>false</bool>
                   </property>
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">background: #fef2f2; border: 1.5px solid #f87171; border-radius: 7px; color: #b91c1c; font-size: 11.5px; font-weight: 600; padding: 6px 10px; margin-top: 2px;</string>
                   </property>
                   <property name="text">
                    <string>Please enter a valid 16-digit card number.</string>
                   </property>
                  </widget>
                 </item>

                 <item>
                  <widget class="QPushButton" name="btnSubmitPayment">
                   <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
                   <property name="styleSheet">
                    <string notr="true">
                     QPushButton#btnSubmitPayment {
                       background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2563eb, stop:1 #1d4ed8);
                       color: #ffffff;
                       font-family: 'Open Sans', -apple-system, sans-serif;
                       font-weight: 700;
                       font-size: 14px;
                       letter-spacing: 0.3px;
                       border-radius: 8px;
                       border: 1px solid #1e40af;
                       border-bottom: 3.5px solid #172554;
                       padding: 10px 18px 12px 18px;
                       margin-top: 6px;
                     }
                     QPushButton#btnSubmitPayment:hover {
                       background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3b82f6, stop:1 #2563eb);
                       border-bottom: 3.5px solid #1e3a8a;
                     }
                     QPushButton#btnSubmitPayment:pressed {
                       background: #1d4ed8;
                       border-bottom: 1px solid #172554;
                       padding-top: 12px;
                       padding-bottom: 10px;
                     }
                    </string>
                   </property>
                   <property name="text"><string>Generate Code</string></property>
                  </widget>
                 </item>

                 <item>
                 <widget class="QPushButton" name="btnBackFromPayment">
                  <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
                  <property name="styleSheet"><string notr="true">QPushButton#btnBackFromPayment { background: transparent; color: #64748b; font-weight: 600; font-size: 12px; padding: 3px; border: none; } QPushButton#btnBackFromPayment:hover { color: #2563eb; }</string></property>
                  <property name="text"><string>← Back to Subscription Plans</string></property>
                 </widget>
                </item>
               </layout>
              </widget>

              <!-- VIEW 1: Payment Success & 16-Digit Code View -->
              <widget class="QWidget" name="pagePaymentSuccess">
               <layout class="QVBoxLayout" name="paySuccessLayout">
                <property name="spacing"><number>10</number></property>
                <property name="leftMargin"><number>6</number></property>
                <property name="topMargin"><number>10</number></property>
                <property name="rightMargin"><number>6</number></property>
                <property name="bottomMargin"><number>6</number></property>

                <item>
                 <layout class="QHBoxLayout" name="successBadgeRow">
                  <item><spacer name="scSpacerLeft"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                  <item>
                   <widget class="QLabel" name="lblSuccessBadge">
                    <property name="styleSheet"><string notr="true">background: #ecfdf5; color: #059669; border: 1.5px solid #a7f3d0; border-radius: 20px; padding: 6px 16px; font-weight: 700; font-size: 12.5px;</string></property>
                    <property name="text"><string>✓ Payment Successful • Order Confirmed</string></property>
                   </widget>
                  </item>
                  <item><spacer name="scSpacerRight"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                 </layout>
                </item>

                <item>
                 <widget class="QLabel" name="lblSuccessTitle">
                  <property name="alignment"><set>Qt::AlignCenter</set></property>
                  <property name="styleSheet"><string notr="true">font-size: 20px; font-weight: 700; color: #0f172a; font-family: 'Open Sans', sans-serif;</string></property>
                  <property name="text"><string>Your 16-Digit License Code</string></property>
                 </widget>
                </item>

                <item>
                 <widget class="QLabel" name="lblSuccessInstruction">
                  <property name="alignment"><set>Qt::AlignCenter</set></property>
                  <property name="styleSheet"><string notr="true">color: #64748b; font-size: 12px; font-family: 'Open Sans', sans-serif;</string></property>
                  <property name="text"><string>Use this cryptographic activation code to activate your workstation seat:</string></property>
                 </widget>
                </item>

                <!-- 16-Digit Code Box -->
                <item>
                 <widget class="QFrame" name="frameGeneratedCode">
                  <property name="styleSheet"><string notr="true">background: #f0fdf4; border: 2px dashed #059669; border-radius: 10px; padding: 12px 16px;</string></property>
                  <layout class="QHBoxLayout" name="codeBoxLayout">
                   <item><spacer name="cbSpacerL"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                   <item>
                    <widget class="QLabel" name="lblGeneratedCodeDisplay">
                     <property name="font">
                      <font><pointsize>20</pointsize><bold>true</bold></font>
                     </property>
                     <property name="styleSheet"><string notr="true">font-family: monospace; font-size: 21px; font-weight: 800; color: #047857; letter-spacing: 3px;</string></property>
                     <property name="text"><string>HAKE-XXXX-XXXX-XXXX</string></property>
                    </widget>
                   </item>
                   <item><spacer name="cbSpacerR"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                   <item>
                    <widget class="QPushButton" name="btnCopyGeneratedCode">
                     <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
                     <property name="styleSheet"><string notr="true">background: #ffffff; color: #047857; border: 1px solid #a7f3d0; border-radius: 6px; padding: 6px 12px; font-weight: 600; font-size: 11.5px;</string></property>
                     <property name="text"><string>Copy</string></property>
                    </widget>
                   </item>
                  </layout>
                 </widget>
                </item>

                <item>
                 <spacer name="successSpacerMid"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer>
                </item>

                <item>
                 <widget class="QPushButton" name="btnGoActivateFromPayment">
                  <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
                  <property name="styleSheet">
                   <string notr="true">
                    QPushButton#btnGoActivateFromPayment {
                      background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2563eb, stop:1 #1d4ed8);
                      color: #ffffff;
                      font-family: 'Open Sans', -apple-system, sans-serif;
                      font-weight: 700;
                      font-size: 14px;
                      border-radius: 8px;
                      border: 1px solid #1e40af;
                      border-bottom: 3.5px solid #172554;
                      padding: 12px 20px 14px 20px;
                    }
                    QPushButton#btnGoActivateFromPayment:hover {
                      background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3b82f6, stop:1 #2563eb);
                      border-bottom: 3.5px solid #1e3a8a;
                    }
                    QPushButton#btnGoActivateFromPayment:pressed {
                      background: #1d4ed8;
                      border-bottom: 1px solid #172554;
                      padding-top: 14px;
                      padding-bottom: 12px;
                    }
                   </string>
                  </property>
                  <property name="text"><string>Activate Hake GeoDesk License Now →</string></property>
                 </widget>
                </item>

                <item>
                 <widget class="QPushButton" name="btnBackToPlansFromSuccess">
                  <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
                  <property name="styleSheet"><string notr="true">QPushButton#btnBackToPlansFromSuccess { background: transparent; color: #64748b; font-weight: 600; font-size: 12px; padding: 2px; border: none; } QPushButton#btnBackToPlansFromSuccess:hover { color: #2563eb; }</string></property>
                  <property name="text"><string>← Return to Subscription Plans</string></property>
                 </widget>
                </item>
               </layout>
              </widget>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <spacer name="payRightSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
</widget>
   </item>
  </layout>

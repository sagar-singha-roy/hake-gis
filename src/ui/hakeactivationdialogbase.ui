          <!-- Actions Row: "I have an activation code" + "View subscription plans" -->
          <item>
           <layout class="QHBoxLayout" name="actionShortcutsLayout">
            <property name="spacing">
             <number>10</number>
            </property>
            <item>
             <widget class="QPushButton" name="btnGoActivate">
              <property name="cursor">
               <cursorShape>PointingHandCursor</cursorShape>
              </property>
              <property name="styleSheet">
               <string notr="true">
                QPushButton#btnGoActivate {
                  background-color: #f8fafc;
                  color: #1e293b;
                  font-family: 'Open Sans', -apple-system, sans-serif;
                  border: 1.5px solid #cbd5e1;
                  border-bottom: 2.5px solid #94a3b8;
                  border-radius: 8px;
                  padding: 9px 12px 10px 12px;
                  font-size: 11.5px;
                  font-weight: 600;
                }
                QPushButton#btnGoActivate:hover {
                  background-color: #f1f5f9;
                  border-color: #94a3b8;
                  border-bottom: 2.5px solid #64748b;
                }
                QPushButton#btnGoActivate:pressed {
